{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "twilio/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "status.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/twilio/(.*)",
      "dest": "/twilio/$1.js",
      "status": 200
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.js",
      "status": 200
    },
    {
      "src": "/status",
      "dest": "/status.js",
      "status": 200
    }
  ]
}
